{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poker-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      // One global instance holding anonymous daily counters (see src/stats.ts).
      { "name": "STATS", "class_name": "Stats" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Stats"] }
  ],
  // Secrets (wrangler secret put): SLACK_SIGNING_SECRET, SLACK_CLIENT_SECRET, SUGGEST_TOKEN,
  // STATS_TOKEN (unlocks /stats).
  // SLACK_CLIENT_ID is public (Slack app A0CEYFX69QS).
  "vars": {
    "APP_URL": "https://agilepoker.dev",
    "SLACK_CLIENT_ID": "12493322659687.12508541213842",
    // Feature suggestions are forwarded here; SUGGEST_TOKEN is a secret shared with that endpoint.
    "SUGGEST_URL": "https://tarastarlov.com/api/push?suggest=1",
    "ALLOWED_ORIGINS": "http://localhost:3000,https://agilepoker.dev,https://www.agilepoker.dev,https://poker-ai-eta.vercel.app,https://poker-*-ttarlovs-projects.vercel.app,https://poker-ai-git-*-ttarlovs-projects.vercel.app"
  },
  // 60 new connections or room lookups per minute per IP (approximate, per location).
  "ratelimits": [
    { "name": "CONNECT_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    // Suggestion form: 3 per minute per IP (the inbox also caps 5/hour per visitor).
    { "name": "FEEDBACK_LIMITER", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
