# Room server (Cloudflare Worker). Local default: `npm run dev:rooms` → http://localhost:8787
NEXT_PUBLIC_ROOMS_URL=http://localhost:8787

# Optional Jira import. Leave NEXT_PUBLIC_JIRA_ENABLED unset on public deployments.
NEXT_PUBLIC_JIRA_ENABLED=
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token
